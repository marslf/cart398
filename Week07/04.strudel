setcpm(138)

$: n("0 3 7 10 0 3 [7 10] 12").s("sawtooth")
  .lpf(sine.range(200,3200).slow(4))
  .lpq(18).attack(0.01).decay(0.2).sustain(0.3)
  .gain(0.7).distort(0.6)
  .room(0.2).delay(0.25)

$: sound("bd bd:2 bd bd:2").bank("RolandTR909")
  .gain(0.7).orbit(2)

$: sound("~ hh ~ hh, ~ ~ oh ~").bank("RolandTR909")
  .gain(0.5).orbit(3)

$: sound("cp ~ cp ~").bank("RolandTR909")
  .gain(0.6).room(0.3).orbit(4)

$: note("<[c4,eb4,g4] [bb3,d4,f4] [ab3,c4,eb4] [g3,bb3,d4]>/2")
  .s("piano").room(0.6).gain(0.6)
  .delay(0.3).delaytime(0.375)

$: note("c3 ~ g3 ~ c3 ~ ab3 bb3")
  .s("sawtooth").lpf(cosine.range(400,4000).slow(8))
  .lpq(12).gain(0.5).attack(0.02).decay(0.4)
  .delay(0.5).delaytime(0.375).delayfeedback(0.4)
