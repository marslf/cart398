setcps(118/60/4)

$: s("bd ~ ~ bd ~ bd ~ ~ ~ bd ~ ~ bd ~ ~ ~")
  .gain(0.7).cutoff(sine.range(600,3000))

$: s("~ ~ clap ~ ~ ~ clap ~ ~ ~ clap ~ ~ ~ ~ ~")
  .gain(0.6)

$: s("hh(5,16)")
  .gain(0.65).every(4, x => x.fast(2))

$: s("perc:2*8")
  .gain(0.25).degradeBy(0.3).lpf(3000)

$: n("[0@2 ~ 3@2 5@3 ~ 7 ~ ~ 5@3 ~ 0@2 ~ 3@2 5@3 ~ [7 ,5] ~ ~ 3@3 ~]/2")
  .scale("C:dorian").sound("sawtooth").lpf(600).gain(0.45).legato(1.4).room(0.15)

$: n("0@3 3@2 5@3")
  .scale("C:dorian").sound("sawtooth").lpf(400).gain(0.3).legato(1.8).slow(2).degradeBy(0.15)

$: n("[~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 12]/4")
  .scale("C:dorian").sound("gm_fx_crystal").gain(0.35).delay(0.3).room(0.5).every(8, x => x.fast(4))
