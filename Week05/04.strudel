setcps(105/60/4)

$: n("<0 2 4 7 5 4 2 7>")
  .scale("D:dorian").sound("piano").gain(0.6).legato(1.4).room(0.35)

$: n("~ 9 7 ~ 5 4 ~ 2")
  .scale("D:dorian").sound("piano").gain(0.45).legato(1.3).room(0.4)

$: n("[0 4 7 9]")
  .scale("D:dorian").sound("gm_pad_warm").gain(0.3).lpf(900).legato(2).slow(2).degradeBy(0.2)

$: s("bd ~ ~ bd ~ ~ bd ~")
  .gain(0.6).bank("RolandTR909")

$: s("~ rim ~ ~ rim ~ ~ ~")
  .gain(0.4).bank("RolandTR909")

$: s("hh(3,8)")
  .gain(0.55).bank("RolandTR909")

$: n("0 ~ 4 ~ 5 ~ 2 ~")
  .scale("D:dorian").sound("sawtooth").lpf(500).gain(0.75).legato(1.3)
