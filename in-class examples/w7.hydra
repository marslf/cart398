//WEEK 7 using hydra

//intesting patch: https://hydra.ojack.xyz/?sketch_id=alexandre_1

//BASIC FUNCTION
osc(20).out()
osc( 1, 1, 1).out() 
osc( 1, 1).out() \
osc( 5, 1, 10).out() 

//--- INTRO EXPERIMENTATION TIME ---

// ROTATE
osc(1, 2, 5).rotate().out() //gradient at an angle
osc(1, 2, 5).rotate(5).out() //vertical gradient movement

// KALEIDOSCOPE
osc(5,-1,5).rotate(0, 0.2).kaleid().out()

// REPEAT
osc(5, 1, 10).rotate(0, 0.2).kaleid().repeat().out()

// PIXELATE
osc( 5, 1, 10).rotate(0, 0.2).kaleid().pixelate(100,10).out()

// NOISE
noise(4).color(2, 1).out()

// COLORAMA
osc(5,-1,5).rotate(0, 0.2).kaleid().colorama().out()

//SHAPE
shape(3).repeat(3, 2).scrollX(0, 0.1).out()
shape(3).rotate(0, 0.5).colorama().out()

//-------------

// TYPES OF SOURCES

// OSC
osc(10).out()

// SOLID 
solid(10).out()

//NOISE
noise(10).out()

// VORONOI
voronoi(10).out()
voronoi(100, 10, 10).out()
voronoi(10, 1, 10).out()

// SHAPE
shape(3).out()

// GRADIENT
gradient(2).out()

//--------------

//ARROW MATH FUNCTIONS + TIME
osc(() => Math.sin(time*10) * 0.5 +0.5 +1, 0 ,0).out()

noise( () => Math.sin(time/10)*50, () => Math.sin(time/2)/500).out()

//--------------

// --- GEOMETRY TRANSFORMS ---
//source > geometry trasnform > color transform . out

//ROTATE(angle, speed)
osc( 5, 1, 10).rotate(20, 1).out() 
osc( 5, 1, 10).rotate(10, 4).out()

//SCALE(amount, xMult, yMult, offsetX, offsetY)
shape(4, 0.3, 0).scale(1, 9/16, 2).out()
shape(4, 0.3, 0).scale(()=> 0.125*Math.sin(2*time)+0.05, 9.16).out()

//ICA 1
shape(60, 0.5, 0).color(1,0,0).scale(()=> 0.5*Math.sin(5*time), 0.5,1).out()

voronoi(10).color(1,1,0).scale(()=> Math.sin(1.5*time)+5).out()

//OUTPUTS

//hydra has 4 virtual buffers : o0,o1,o2,o3 (default is o0)
//out(o2)
//render() //to show all 4 splitscreen
//render(o2) //show o2 full screen

shape(60, 0.5, 0).color(1,0,0).scale(()=> 0.5*Math.sin(5*time), 0.5,1).out(o0)
voronoi(10).color(1,1,0).scale(()=> Math.sin(1.5*time)+5).out(o1) 
osc(1, 2, 5).rotate(5).out(o2)
osc(() => Math.sin(time*10) * 0.5 +0.5 +1, 0 ,0).out(o3)

render(o1)

// -------------------------

//ICA 2 exploration 

// - V1 -
voronoi(10)
  .color(1,0.5,0)
  .colorama(()=> Math.sin(time*0.2)*0.5 + 0.5)
  .rotate(()=> time*0.05)
  .scale(()=> Math.sin(0.8*time)*0.1 + 1)
  .modulate(
    osc(3,0,0.5)
      .rotate(()=>time*0.1)
      .scale(1.2),
    0.1
  )
  .out()

// - V2 -

voronoi(10, 0.3, 0.8)
  .color(1,0.5,0)
  .colorama(()=> Math.sin(time*0.2)*0.5 + 0.5)
  .rotate(()=> time*0.05)
  .scale(()=> Math.sin(0.8*time)*0.1 + 1)
  .modulate(
    osc(3,0,0.5)
      .rotate(()=>time*0.1)
      .scale(1.2),
    0.1
  )
  .diff(
    noise(15,.04).brightness(.2).contrast(1.3)
    .mult( osc(9,0, ()=>Math.sin(time/5)+13 ) )
    .rotate( ()=>time/33 ))
  .mult(
    shape(100,0.5,0.02)
      .scale(1,0.8)
      .scrollY(()=> Math.sin(time*0.3)*0.02)
  )
  .out()

