//   .out()

osc(P(2), P(2))
  .color(0.3, 0, 0.4)
  .colorama(0.4)
  .saturate(P(3))
  .rotate( () => time%360)
  .scale(() => P(0.125*Math.sin(2*time)+0.5), 9/16, 1, 0.4, 0)
  .kaleid(P("4 3 4 5"))
  .add(noise(P("5 7 20 30")))
  //.add(shape(3).repeat(4, 3, 0, 0).scrollY(3).colorama(0.6).scale(0.125*Math.sin(2*time) + 0.5))
  .out()

noise(3, 0.1)
  .color(0.6, 0.5, 1)
  .colorama(P("10 4 2 7"))
  .posterize(3, 1, 0.5)
  .kaleid(P("4 5 6 7"))
  .scale(3, 0.65, 0.5)
  .saturate(0.4)
  .out();

voronoi(5,0.8,0.3)
  .scale(1.75, 0.65, 0.5)
  .color(1, 1, 0.5)
  .add(noise(5).colorama(4))
  .out()







