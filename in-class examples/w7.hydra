  osc(P("4 5 6"), 2)
  .color(0, 0, 0.2)
  .colorama(P("0.3 0.6 1 5 7"))
  .add(noise(4, 1))
  .rotate(0.6)
  .kaleid(P("2 1 1"))
  .out()

