$: "<0 ~[1,2]@6 [1,2]@2>/4"
  .pick([
   s("<[~ bd]*4>"),
    s("<bd lt [bd [~ bd]] lt [bd <~ bd>] [[cr bd] ~]>*2"),
    s("<bd cr*4 sd [hh sd]>")
  ]).bank("RolandTR808").room(0.3).lpf("<1200 1000 9000>").gain(0)

