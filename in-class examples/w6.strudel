// // NOTE: you might need to close and reopen your browser if it doesnt seem to be connecting properly


// // Basic MIDI Output
// // Connect to a MIDI device by name (e.g., 'IAC Driver' on Mac, 'loopMIDI' on Windows)
// // javascript// MIDI note numbers (60 = middle C)
// // Swatches - 15
// // note("60 64 67 71")
// //   .midi('loopMIDI Port')

// // note("c4 e4 g4 b4")
// //   .midi('loopMIDI Port')

// // // Specifying MIDI Channel
// // note("c4 e4 g4 b4")
// //   .midi('loopMIDI Port', 1) // Channel 1

// // // Chords & Patterns
// // note("<[c3,e3,g3] [f3,a3,c4] [g3,b3,d4]>")
// //   .midi('loopMIDI Port') // Channel 1

// // // With Velocity & Duration
// // note("[c4 e4 g4 b4 c4 e4 c4 e5 g4 e4 c4 e4]/2")
// //   .velocity("<0.8 0.4 0.6 1.0>")   // velocity 0–1
// //   .legato("<0.8 0.4 1>")           // note length
// //   .midi('loopMIDI Port')

// // MY FAVS: 169- End Titles, 38- Dear Freddie Chorus, 
// // 57- Concert Flute 1, 66- Lovely Tines, 96- Swagger Tight EQ (Chord),
// //119- Doom Drum (var), 130- Lilac, 527- Effervescence, 
// //

// //----------------------

// //use arrange to play specific sections one at a time (or a few at a time) 
// //control number of repetitions


