setcps(120/60/4)

$: n("[c e g e]/4").s("piano").scale("C:major").gain(0.7).room(0.4).delay(0.2)
$: n("[0 3 5 3]/2").s("gm_pad_warm").scale("C:major").gain(0.5).lpf(900).room(0.6)
$: note("{<c , e> <d , g> <e , a>}%8").s("sawtooth").lpf(600).lpq(0.8).gain(0.3).slow(2)
$: s("bd ~ ~ ~").gain(0.6)
$: s("hh*8").gain(0.4).lpf(2500)
