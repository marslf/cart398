setcpm(60) 

$: note("c4 ~ e4 ~ g4 ~ [e4 d4] ~").sound("piano")
  .gain(0.7)
  .slow(2)
  .room(0.9)
  .roomsize(0.8)
  .delay(0.3)
  .delaytime(0.75)
  .delayfeedback(0.4)

$: note("<c3 ~ g3 ~ f3 ~ c3 ~>").sound("piano")
  .gain(0.5)
  .slow(4)
  .room(0.95)

$: note("<c4 g4 f4 g4>").sound("supersaw")
  .gain(0.55)
  .lpf(600)
  .lpq(0.2)
  .room(1)
  .slow(4)

$: sound("bd ~ bd ~").bank("RolandTR808")
  .gain(0.58)
  .lpf(180)
  .room(0.6)
  .roomsize(0.5)

$: sound("~ ~ rim ~ ~ rim ~ ~").bank("RolandTR808")
  .gain(0.22)
  .room(0.7)
  .roomsize(0.6)
  .delay(0.2)
  .delaytime(0.5)
  .delayfeedback(0.25)

$: sound("~ hh ~ ~ ~ hh ~ ~").bank("RolandTR808")
  .gain(0.48)
  .hpf(6000)
  .room(0.5)
