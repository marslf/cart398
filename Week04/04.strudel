setcps(115/60/4)

$: note("<[c e g] [a c e] [f a c] [g b d]>")
  .sound("supersaw").gain(0.45).lpf(1200).room(0.3).every(4, x => x.rev())
$: n("0 0 3 5")
  .scale("C:major").sound("sawtooth").lpf(700).gain(0.5)
$: n("[7 9 12 11 9]")
  .scale("C:major").sound("pluck").gain(0.35).delay(0.25).degradeBy(0.25).every(5, x => x.fast(2))
$: s("bd*4")
  .gain(0.9).every(7, x => x.degradeBy(0.4)) 
$: s("hh*8")
  .gain(0.35).degradeBy(0.15).every(3, x => x.fast(2))
$: s("~ clap ~ clap")
  .gain(0.6).every(4, x => x.delay(0.2))
