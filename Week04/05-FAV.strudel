setcps(150/60/4)

$: note("<[c e g b] [a c e g] [f a c e] [g b d f]>")
  .sound("supersaw").gain(0.5).hpf(400).room(0.25).every(7, x => x.rev())
$: n("0 [0 12] 7 5")
  .scale("C:major").sound("sawtooth").lpf(900).gain(0.55).every(6, x => x.fast(2))
$: n("<12 14 16 19 17>")
  .scale("C:major").sound("pluck").gain(0.35).delay(0.2).degradeBy(0.3).every(5, x => x.fast(2))
$: s("bd*4")
  .gain(1)
$: s("~ clap ~ clap")
  .gain(0.8).every(4, x => x.delay(0.15))
$: s("hh*16")
  .gain(0.3).degradeBy(0.2).every(3, x => x.fast(2))
