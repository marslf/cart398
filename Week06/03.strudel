//--- 03 Fun bouncy beat ---

setcps(138/60/4)

$: s("bd ~ ~ ~ bd ~ ~ ~ bd ~ bd ~ ~ ~ bd ~")
  .gain(0.6).cutoff(sine.slow(5).range(800,3000)).shape(0.2).room(0.12)

$: s("hh(9,16,3)")
  .gain(sine.slow(3).range(0.4,0.6)).lpf(sine.slow(6).range(4000,9000))
  .pan(sine.slow(4)).every(3, x => x.fast(1.5))

$: s("~ ~ rim ~ ~ rim ~ rim ~ ~ ~ rim ~ ~ rim ~")
  .bank("RolandTR707").gain(0.35).pan(rand).degradeBy(0.2).lpf(6000)

$: n("[0 ~ 0 3 ~ 5 ~ ~ 7 ~ 5 ~ 3 ~ 2 ~]/2")
  .scale("G:major").sound("sawtooth").lpf(sine.slow(10).range(500,1400))
  .gain(0.5).legato(0.9).shape(0.2).room(0.1)

$: n("{<0 3 5 7> <5 7 9 ~> <3 5 ~ 7> <7 ~ 9 12>}%8")
  .scale("G:major").sound("gm_xylophone").gain(0.3).lpf(6000)
  .delay(0.2).delaytime(0.125).room(0.3).every(5, x => x.fast(2))

$: n("[~ ~ ~ 14@2 ~ ~ ~ ~ ~ ~ ~ 12@2 ~ ~ ~ ~]/4")
  .scale("G:major").sound("gm_fx_crystal").gain(0.4)
  .delay(0.5).room(0.65).every(7, x => x.rev())

$: n("[0@4 ~ 4@3 ~ 7@4 ~ 5@3 ~ 3@4]/2")
  .scale("G:major").sound("gm_pad_warm").lpf(sine.slow(22).range(600,1300))
  .gain(0.3).legato(3.5).room(0.45).slow(2)
